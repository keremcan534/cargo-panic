{
  "name": "cargo-panic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cargo Panic - a mobile-first casual warehouse balance puzzle by BlackBlue Studios",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-levels.ts",
    "validate:endless": "tsx scripts/validate-endless.ts",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "baseline": "tsx scripts/baseline-snapshot.ts",
    "test:e2e": "playwright test",
    "store:explore": "npm run build && tsx marketing/explore.ts",
    "store:capture": "npm run build && tsx marketing/capture.ts",
    "store:video": "tsx marketing/render.ts",
    "store:stills": "tsx marketing/stills.ts",
    "store:android-icons": "tsx marketing/android-icons.ts",
    "store:assets": "npm run store:capture && npm run store:video && npm run store:stills",
    "android": "npm run build && cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.3.0",
    "@types/three": "^0.170.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "three": "^0.170.0"
  }
}
